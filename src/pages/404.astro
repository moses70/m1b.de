---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 - Page Not Found | m1b.de">
  <div class="max-w-2xl mx-auto px-4 py-24 text-center space-y-6">
    <div class="inline-flex p-4 rounded-2xl bg-brand-950/80 border border-brand-800 text-brand-400 font-mono text-3xl font-bold">
      404
    </div>

    <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-100 tracking-tight">
      Page Not Found
    </h1>

    <p class="text-slate-400 text-sm leading-relaxed">
      Sorry, the requested page could not be found. It may have been moved or the link is outdated.
    </p>

    <div class="pt-4">
      <a
        href="/"
        class="inline-flex items-center space-x-2 px-6 py-3 rounded-lg font-semibold text-sm bg-brand-500 hover:bg-brand-400 text-slate-950 transition-all shadow-lg shadow-brand-500/20"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
        <span>Back to Home</span>
      </a>
    </div>
  </div>
</BaseLayout>
