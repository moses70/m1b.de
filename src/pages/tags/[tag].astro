---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { slugifyTag } from '../../utils/slugify';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  
  // Map tag slug -> original tag label
  const tagMap = new Map<string, string>();
  allPosts.forEach((post) => {
    post.data.tags.forEach((tag) => {
      tagMap.set(slugifyTag(tag), tag);
    });
  });

  return Array.from(tagMap.entries()).map(([slug, originalTag]) => {
    const filteredPosts = allPosts
      .filter((post) =>
        post.data.tags.some((t) => slugifyTag(t) === slug)
      )
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

    return {
      params: { tag: slug },
      props: { tag: originalTag, posts: filteredPosts },
    };
  });
}

const { tag, posts } = Astro.props;
---

<BaseLayout
  title={`Artikel zu #${tag} | m1b.de`}
  description={`Alle Fachbeiträge und Artikel zum Thema #${tag} auf m1b.de.`}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-8">
    
    <header class="border-b border-slate-800 pb-8 space-y-2">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-brand-950 text-brand-300 text-xs font-mono border border-brand-800/50">
        <span>Thema</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-100 tracking-tight">
        #{tag}
      </h1>
      <p class="text-sm text-slate-400">
        {posts.length} {posts.length === 1 ? 'Artikel' : 'Artikel'} zu diesem Thema gefunden.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {posts.map((post) => (
        <BlogCard post={post} />
      ))}
    </div>

  </div>
</BaseLayout>
