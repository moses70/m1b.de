---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const filteredHeadings = headings.filter((h) => h.depth <= 3);
---

{filteredHeadings.length > 0 && (
  <nav class="p-4 rounded-xl border border-slate-800 bg-slate-900/60 text-xs font-mono mb-8">
    <div class="text-slate-300 font-bold uppercase tracking-wider mb-3 flex items-center space-x-2">
      <svg class="w-4 h-4 text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
      </svg>
      <span>Inhaltsverzeichnis</span>
    </div>
    <ul class="space-y-2">
      {filteredHeadings.map((h) => (
        <li class={h.depth === 3 ? 'pl-4' : ''}>
          <a
            href={`#${h.slug}`}
            class="text-slate-400 hover:text-brand-300 transition-colors block truncate"
          >
            {h.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
