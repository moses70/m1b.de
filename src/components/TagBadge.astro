---
import { slugifyTag } from '../utils/slugify';

interface Props {
  tag: string;
}

const { tag } = Astro.props;
const tagSlug = slugifyTag(tag);
---

<a
  href={`/tags/${tagSlug}`}
  class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-brand-950 text-brand-300 border border-brand-800/50 hover:bg-brand-900 hover:border-brand-500 transition-colors"
>
  #{tag}
</a>
