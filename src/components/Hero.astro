<section class="relative py-12 md:py-20 border-b border-slate-800 overflow-hidden">
  <!-- Subtle background glow -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-brand-500/10 blur-3xl rounded-full pointer-events-none"></div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center relative z-10 space-y-6">
    <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-brand-950/80 border border-brand-800/60 text-brand-300 text-xs font-mono">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      <span>Software Engineering & Architecture Blog</span>
    </div>

    <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-white leading-tight">
      Praxisnahes IT-Wissen & <br class="hidden sm:inline" />
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-400 via-indigo-400 to-sky-300">
        Anwendungsarchitektur
      </span>
    </h1>

    <p class="text-lg sm:text-xl text-slate-300 max-w-2xl mx-auto font-light leading-relaxed">
      Notizen und Leitfäden zu <strong>C# / .NET</strong>, <strong>DevOps & GitHub Actions</strong>, <strong>Industrie-Automatisierung</strong> und modernen <strong>Web-Technologien</strong> von Reinhard Moosauer.
    </p>

    <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
      <a
        href="/blog"
        class="px-6 py-3 rounded-lg font-semibold text-sm bg-brand-500 hover:bg-brand-400 text-slate-950 shadow-lg shadow-brand-500/25 transition-all transform hover:-translate-y-0.5"
      >
        Artikel durchsuchen
      </a>
      <a
        href="/about"
        class="px-6 py-3 rounded-lg font-semibold text-sm bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition-all"
      >
        Über m1b.de
      </a>
    </div>
  </div>
</section>
