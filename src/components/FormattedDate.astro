---
interface Props {
  date: Date;
  className?: string;
}

const { date, className = '' } = Astro.props;
const formattedDate = date.toLocaleDateString('de-DE', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<time datetime={date.toISOString()} class={className}>
  {formattedDate}
</time>
