---
const currentYear = new Date().getFullYear();
---

<footer class="mt-auto border-t border-slate-800 bg-slate-950/80 text-slate-400">
  <div class="max-w-6xl mx-auto px-4 py-10 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
      
      <!-- Column 1: Brand & Bio -->
      <div class="space-y-3">
        <div class="flex items-center space-x-2">
          <div class="w-7 h-7 rounded bg-brand-500 flex items-center justify-center font-mono font-bold text-white text-sm">
            m1b
          </div>
          <span class="font-bold text-slate-200">m1b.de</span>
        </div>
        <p class="text-xs text-slate-400 leading-relaxed">
          Moosauer IT Consulting & Software Engineering. Blog on modern application architecture, C#, DevOps, automation & cloud.
        </p>
      </div>

      <!-- Column 2: Navigation -->
      <div>
        <h3 class="text-sm font-semibold text-slate-200 tracking-wider uppercase mb-3 font-mono">
          Navigation
        </h3>
        <ul class="space-y-2 text-xs">
          <li><a href="/" class="hover:text-brand-400 transition-colors">Home</a></li>
          <li><a href="/blog" class="hover:text-brand-400 transition-colors">All Articles</a></li>
          <li><a href="/tags" class="hover:text-brand-400 transition-colors">Tags / Topics</a></li>
          <li><a href="/about" class="hover:text-brand-400 transition-colors">About Reinhard Moosauer</a></li>
        </ul>
      </div>

      <!-- Column 3: Connect -->
      <div>
        <h3 class="text-sm font-semibold text-slate-200 tracking-wider uppercase mb-3 font-mono">
          Connect
        </h3>
        <ul class="space-y-2 text-xs">
          </li>
          <li>
            <a href="mailto:office@moosauer.de" class="hover:text-brand-400 transition-colors">
              Email: office@moosauer.de
            </a>
          </li>
          <li>
            <a href="/rss.xml" class="hover:text-brand-400 transition-colors">
              RSS Feed
            </a>
          </li>
        </ul>
      </div>

    </div>

    <div class="pt-6 border-t border-slate-800/80 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500">
      <p>© {currentYear} Reinhard Moosauer – m1b.de. All rights reserved.</p>
      <p class="mt-2 sm:mt-0 font-mono">Built with Astro & GitHub Actions</p>
    </div>
  </div>
</footer>
