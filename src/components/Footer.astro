---
const currentYear = new Date().getFullYear();
---

<footer class="mt-auto border-t border-slate-800 bg-slate-950/80 text-slate-400">
  <div class="max-w-6xl mx-auto px-4 py-10 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
      
      <!-- Column 1: Brand & Bio -->
      <div class="space-y-3">
        <div class="flex items-center space-x-2">
          <div class="w-7 h-7 rounded bg-brand-500 flex items-center justify-center font-mono font-bold text-white text-sm">
            m1b
          </div>
          <span class="font-bold text-slate-200">m1b.de</span>
        </div>
        <p class="text-xs text-slate-400 leading-relaxed">
          Moosauer IT Beratung & Software Engineering. Blog über moderne Anwendungsarchitektur, C#, DevOps, Automatisierung & Cloud.
        </p>
      </div>

      <!-- Column 2: Navigation -->
      <div>
        <h3 class="text-sm font-semibold text-slate-200 tracking-wider uppercase mb-3 font-mono">
          Navigation
        </h3>
        <ul class="space-y-2 text-xs">
          <li><a href="/" class="hover:text-brand-400 transition-colors">Startseite</a></li>
          <li><a href="/blog" class="hover:text-brand-400 transition-colors">Alle Artikel</a></li>
          <li><a href="/tags" class="hover:text-brand-400 transition-colors">Tags / Themen</a></li>
          <li><a href="/about" class="hover:text-brand-400 transition-colors">Über Reinhard Moosauer</a></li>
        </ul>
      </div>

      <!-- Column 3: Connect -->
      <div>
        <h3 class="text-sm font-semibold text-slate-200 tracking-wider uppercase mb-3 font-mono">
          Connect
        </h3>
        <ul class="space-y-2 text-xs">
          <li>
            <a
              href="https://github.com/moses70"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center space-x-2 hover:text-brand-400 transition-colors"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
              </svg>
              <span>GitHub (moses70)</span>
            </a>
          </li>
          <li>
            <a href="mailto:office@moosauer.de" class="hover:text-brand-400 transition-colors">
              E-Mail: office@moosauer.de
            </a>
          </li>
          <li>
            <a href="/rss.xml" class="hover:text-brand-400 transition-colors">
              RSS Feed
            </a>
          </li>
        </ul>
      </div>

    </div>

    <div class="pt-6 border-t border-slate-800/80 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500">
      <p>© {currentYear} Reinhard Moosauer – m1b.de. Alle Rechte vorbehalten.</p>
      <p class="mt-2 sm:mt-0 font-mono">Gebaut mit Astro & GitHub Actions</p>
    </div>
  </div>
</footer>
