---
import FormattedDate from './FormattedDate.astro';
import TagBadge from './TagBadge.astro';
import { getReadingTime } from '../utils/readingTime';

interface Props {
  post: {
    slug: string;
    body: string;
    data: {
      title: string;
      description: string;
      pubDate: Date;
      author: string;
      tags: string[];
      featured?: boolean;
    };
  };
}

const { post } = Astro.props;
const readingTime = getReadingTime(post.body);
---

<article class="group relative flex flex-col justify-between rounded-xl border border-slate-800 bg-slate-900/60 p-6 hover:border-brand-500/50 hover:bg-slate-900/90 transition-all duration-200 shadow-md">
  
  {post.data.featured && (
    <div class="absolute -top-3 right-4 bg-brand-500 text-slate-950 font-mono text-[10px] uppercase tracking-widest font-bold px-2.5 py-0.5 rounded-full shadow-sm">
      Featured
    </div>
  )}

  <div class="space-y-3">
    <!-- Meta info: Date & Reading time -->
    <div class="flex items-center space-x-2 text-xs text-slate-400 font-mono">
      <FormattedDate date={post.data.pubDate} />
      <span>•</span>
      <span>{readingTime}</span>
    </div>

    <!-- Title -->
    <h2 class="text-xl font-bold text-slate-100 group-hover:text-brand-300 transition-colors line-clamp-2">
      <a href={`/blog/${post.slug}`} class="focus:outline-none">
        <span class="absolute inset-0" aria-hidden="true"></span>
        {post.data.title}
      </a>
    </h2>

    <!-- Description -->
    <p class="text-sm text-slate-300 line-clamp-3 leading-relaxed">
      {post.data.description}
    </p>
  </div>

  <!-- Tags & Footer -->
  <div class="mt-6 pt-4 border-t border-slate-800/80 flex items-center justify-between z-10">
    <div class="flex flex-wrap gap-1.5">
      {post.data.tags.map((tag) => (
        <TagBadge tag={tag} />
      ))}
    </div>
    <span class="text-xs text-brand-400 font-mono font-medium flex items-center space-x-1 group-hover:translate-x-1 transition-transform">
      <span>Read</span>
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </span>
  </div>

</article>
